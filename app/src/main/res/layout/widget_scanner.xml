<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_scanner_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp"
    android:gravity="top|center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/widget_scanner_icon"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/widget_scanner_bg"
        android:padding="12dp"
        android:tint="@color/md_theme_primary"
        android:src="@drawable/barcode_reader_24"
        android:contentDescription="Escanear Equipamento" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/app_name"
        android:gravity="center"
        android:textAlignment="center"
        android:textSize="12sp"
        android:textColor="#fff"
        android:shadowColor="#000"
        android:shadowRadius="3"
        android:shadowDx="1"
        android:shadowDy="1"
        android:textStyle="bold" />

</LinearLayout>
